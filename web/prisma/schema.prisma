generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String          @id @default(cuid())
  name                         String?
  email                        String          @unique
  emailVerified                Boolean         @default(false)
  image                        String?
  role                         UserRole        @default(USER)
  notesCount                   Int             @default(0)
  coursesCount                 Int             @default(0)
  lastCourseResetDate          DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  lastUsageResetDate           DateTime?
  usedAudioProcessingThisMonth Int             @default(0)
  usedCoursesThisMonth         Int             @default(0)
  usedNotesThisMonth           Int             @default(0)
  usedPdfProcessingThisMonth   Int             @default(0)
  usedVideoProcessingThisMonth Int             @default(0)
  usedSourcesThisMonth         Int             @default(0)
  paddleCustomerId             String?         @map("paddle_customer_id")
  accounts                     Account[]
  sessions                     Session[]
  subscription                 Subscription?
  onboarding                   UserOnboarding?

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

model Subscription {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  paddleSubscriptionId    String             @unique
  priceId                 String
  status                  SubscriptionStatus @default(PENDING)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  nextBillingDate         DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  cancelledAt             DateTime?
  trialEnd                DateTime?
  metadata                Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  amount                  Int?
  audioProcessingPerMonth Int?
  coursesPerMonth         Int                @default(5)
  paddleDiscountId        String?
  notesPerMonth           Int?
  pdfProcessingPerMonth   Int?
  videoProcessingPerMonth Int?
  sourcesPerMonth         Int?
  sourcesPerBatch         Int?
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paddleSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model Transcript {
  id                 String       @id @default(cuid())
  fileName           String
  originalName       String
  content            String
  cleanContent       String
  pages              Int?
  metadata           Json?
  userId             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  type               String       @default("pdf")
  batchId            String?
  sourceKind         String?
  status             String?
  stage              String?
  progress           Int?         @default(0)
  errorCode          String?
  errorMessage       String?
  uploadKey          String?
  rawInput           Json?
  wordCount          Int?
  tokenCount         Int?
  summary            String?
  keyTopics          String[]     @default([])
  suggestedQuestions String[]     @default([])
  readyAt            DateTime?
  folderId           String?
  batch              SourceBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  notes              Note[]

  @@index([batchId])
  @@index([userId, status])
  @@index([folderId])
  @@map("transcripts")
}

model SourceBatch {
  id           String       @id @default(cuid())
  userId       String
  folderId     String?
  status       String       @default("pending")
  totalCount   Int
  readyCount   Int          @default(0)
  failedCount  Int          @default(0)
  skippedCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?
  transcripts  Transcript[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("source_batches")
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @default("#6366f1")
  userId      String
  icon        String?  @default("folder")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]

  @@index([userId])
  @@index([userId, position])
  @@map("folders")
}

model Note {
  id             String            @id @default(cuid())
  title          String
  content        String
  transcriptId   String
  userId         String?
  folderId       String?
  isCloned       Boolean           @default(false)
  sourceNoteId   String?
  originalAuthor String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  flashcard      Flashcard?
  mindmap        MindMap?
  chunks         NoteChunk[]       @relation("NoteToChunks")
  translations   NoteTranslation[]
  folder         Folder?           @relation(fields: [folderId], references: [id])
  transcript     Transcript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  podcasts       Podcast[]
  quiz           Quiz?
  sharedLinks    SharedLink[]

  @@index([folderId])
  @@index([userId])
  @@index([sourceNoteId])
  @@map("notes")
}

model SharedLink {
  id        String    @id @default(cuid())
  noteId    String
  token     String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  viewCount Int       @default(0)
  isActive  Boolean   @default(true)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([noteId])
  @@index([createdBy])
  @@map("shared_links")
}

model NoteTranslation {
  id        String   @id @default(cuid())
  noteId    String
  language  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, language])
  @@index([noteId])
  @@map("note_translations")
}

model Flashcard {
  id        String   @id @default(cuid())
  noteId    String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Json
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String   @unique
  content   Json
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model MindMap {
  id          String   @id @default(cuid())
  title       String
  mermaidCode String
  noteId      String   @unique
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("mind_maps")
}

model Podcast {
  id           String        @id @default(cuid())
  noteId       String
  userId       String?
  jobId        String?       @unique
  podcastId    String?       @unique
  status       PodcastStatus @default(GENERATING)
  progress     Float?        @default(0)
  errorMessage String?
  audioUrl     String?
  duration     Int?
  transcript   Json?
  title        String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  completedAt  DateTime?
  note         Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@index([status])
  @@index([jobId])
  @@index([podcastId])
  @@map("podcasts")
}

model NoteChunk {
  id         Int                   @id @default(autoincrement())
  note_id    String
  chunk_text String
  embedding  Unsupported("vector")
  note       Note                  @relation("NoteToChunks", fields: [note_id], references: [id], onDelete: Cascade)

  @@index([note_id])
  @@map("note_chunks")
}

model ChapterChunk {
  id         Int                   @id @default(autoincrement())
  chapter_id String
  chunk_text String
  embedding  Unsupported("vector")
  source     String                @default("notes")
  chapter    Chapter               @relation("ChapterToChunks", fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_chunks")
}

model Course {
  id           String               @id @default(cuid())
  name         String
  image        String
  userId       String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  units        Unit[]
  userProgress UserCourseProgress[]

  @@map("courses")
}

model Unit {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("units")
}

model Chapter {
  id                 String                @id @default(cuid())
  unitId             String
  name               String
  youtubeSearchQuery String
  videoId            String?
  notes              String?
  transcript         String?
  flashcards         Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  chunks             ChapterChunk[]        @relation("ChapterToChunks")
  unit               Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions          Question[]
  userProgress       UserChapterProgress[]

  @@index([unitId])
  @@map("chapters")
}

model Question {
  id        String   @id @default(cuid())
  chapterId String
  question  String
  answer    String
  options   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("questions")
}

model UserCourseProgress {
  id                   String    @id @default(cuid())
  userId               String
  courseId             String
  completedChapters    Int       @default(0)
  totalChapters        Int       @default(0)
  completionPercentage Float     @default(0)
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_course_progress")
}

model UserChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@map("user_chapter_progress")
}

model BlogPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  content            String
  coverImageUrl      String?
  instructorName     String
  instructorImageUrl String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  @@index([slug])
  @@index([publishedAt])
  @@map("blog_posts")
}

model UserOnboarding {
  id                  String    @id @default(cuid())
  userId              String    @unique
  source              String?
  sourceDetail        String?
  userType            String?
  role                String?
  features            Json?
  studyIntensity      String?
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  currentStep         Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  wantsProductUpdates Boolean   @default(true)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
  @@map("user_onboarding")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  ON_HOLD
  PAUSED
  PAST_DUE
  CANCELLED
  FAILED
  EXPIRED
}

enum PodcastStatus {
  GENERATING
  COMPLETED
  FAILED
}
