// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transcript {
  id          String   @id @default(cuid())
  fileName    String
  originalName String
  content     String
  cleanContent String
  pages       Int?     // Optional for audio transcripts
  metadata    Json?
  type        String   @default("pdf") // "pdf" or "audio"
  userId      String?  // Optional user association
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship to notes
  notes       Note[]

  @@map("transcripts")
}

model Note {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  transcriptId String
  userId      String?  // Optional user association
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship to transcript
  transcript  Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  
  // Relationship to flashcard (one-to-one)
  flashcard   Flashcard?
  
  // Relationship to quiz (one-to-one)
  quiz        Quiz?
  
  @@map("notes")
}

model Flashcard {
  id        String   @id @default(cuid())
  noteId    String   @unique // One flashcard record per note
  content   Json     // JSON array of {id, question, answer} objects
  userId    String?  // Optional user association
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationship to note
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String   @unique // One quiz record per note
  content   Json     // JSON object containing quiz questions array
  userId    String?  // Optional user association
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationship to note
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@map("quizzes")
}
