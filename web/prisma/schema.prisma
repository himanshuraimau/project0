generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  role                UserRole  @default(USER) // USER by default; set to ADMIN in DB when needed
  notesCount          Int       @default(0)
  coursesCount        Int       @default(0) // Total courses created (for reference)
  lastCourseResetDate DateTime? // Track when monthly course count was last reset

  // Usage tracking (reset monthly on subscription renewal)
  usedNotesThisMonth           Int       @default(0)
  usedCoursesThisMonth         Int       @default(0)
  usedPdfProcessingThisMonth   Int       @default(0)
  usedVideoProcessingThisMonth Int       @default(0)
  usedAudioProcessingThisMonth Int       @default(0)
  lastUsageResetDate           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscription Subscription?
  sessions     Session[]
  accounts     Account[]
  onboarding   UserOnboarding?

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Better Auth Account Model (for OAuth providers)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

// Better Auth Verification Model (for email verification)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// Subscription System - New Models
model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  dodoSubscriptionId String             @unique // Dodo Payments subscription ID
  productId          String // Dodo product ID
  status             SubscriptionStatus @default(PENDING)

  // Feature allowances (null = unlimited)
  notesPerMonth           Int? // null for unlimited
  coursesPerMonth         Int  @default(5)
  pdfProcessingPerMonth   Int? // null for unlimited
  videoProcessingPerMonth Int? // null for unlimited
  audioProcessingPerMonth Int? // null for unlimited

  // Discount tracking
  dodoDiscountId String?
  amount         Int? // Actual charged amount in cents

  // Billing period information
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?

  // Cancellation information
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  // Trial information
  trialEnd DateTime?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dodoSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING // Subscription created, payment pending
  ACTIVE // Subscription is active and user has access
  ON_HOLD // Payment failed, subscription on hold
  CANCELLED // Subscription has been cancelled
  FAILED // Subscription creation failed
  EXPIRED // Subscription expired (past due without recovery)
}

model Transcript {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  content      String
  cleanContent String
  pages        Int?
  metadata     Json?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  type         String   @default("pdf")
  notes        Note[]

  @@map("transcripts")
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @default("#6366f1")
  userId      String
  icon        String?  @default("folder")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]

  @@index([userId])
  @@index([userId, position])
  @@map("folders")
}

model Note {
  id             String            @id @default(cuid())
  title          String
  content        String
  transcriptId   String
  userId         String?
  folderId       String?
  isCloned       Boolean           @default(false)
  sourceNoteId   String?
  originalAuthor String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  flashcard      Flashcard?
  chunks         NoteChunk[]       @relation("NoteToChunks")
  transcript     Transcript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  folder         Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  quiz           Quiz?
  mindmap        MindMap?
  translations   NoteTranslation[]
  podcasts       Podcast[]
  sharedLinks    SharedLink[]

  @@index([folderId])
  @@index([userId])
  @@index([sourceNoteId])
  @@map("notes")
}

model SharedLink {
  id        String    @id @default(cuid())
  noteId    String
  token     String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  viewCount Int       @default(0)
  isActive  Boolean   @default(true)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([noteId])
  @@index([createdBy])
  @@map("shared_links")
}

model NoteTranslation {
  id        String   @id @default(cuid())
  noteId    String
  language  String // ISO 639-1 code: 'es', 'fr', 'de', 'zh', 'hi'
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, language])
  @@index([noteId])
  @@map("note_translations")
}

model Flashcard {
  id        String   @id @default(cuid())
  noteId    String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Json
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String   @unique
  content   Json
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model MindMap {
  id          String   @id @default(cuid())
  title       String
  mermaidCode String
  noteId      String   @unique
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("mind_maps")
}

model Podcast {
  id     String  @id @default(cuid())
  noteId String
  userId String?

  // Microservice Integration
  jobId     String? @unique // Microservice job ID
  podcastId String? @unique // Microservice podcast ID

  // Status and Progress
  status       PodcastStatus @default(GENERATING)
  progress     Float?        @default(0)
  errorMessage String?

  // Audio File Information
  audioUrl   String? // S3 URL from microservice
  duration   Int? // Duration in seconds
  transcript Json? // Transcript array from microservice

  // Metadata
  title       String
  description String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@index([status])
  @@index([jobId])
  @@index([podcastId])
  @@map("podcasts")
}

model NoteChunk {
  id         Int                   @id @default(autoincrement())
  note_id    String
  chunk_text String
  embedding  Unsupported("vector")
  note       Note                  @relation("NoteToChunks", fields: [note_id], references: [id], onDelete: Cascade)

  @@index([note_id])
  @@map("note_chunks")
}

model ChapterChunk {
  id         Int                   @id @default(autoincrement())
  chapter_id String
  chunk_text String
  embedding  Unsupported("vector")
  source     String                @default("notes")
  chapter    Chapter               @relation("ChapterToChunks", fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_chunks")
}

model Course {
  id           String               @id @default(cuid())
  name         String
  image        String
  userId       String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  units        Unit[]
  userProgress UserCourseProgress[]

  @@map("courses")
}

model Unit {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("units")
}

model Chapter {
  id                 String                @id @default(cuid())
  unitId             String
  name               String
  youtubeSearchQuery String
  videoId            String?
  notes              String?
  transcript         String?
  flashcards         Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  chunks             ChapterChunk[]        @relation("ChapterToChunks")
  unit               Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions          Question[]
  userProgress       UserChapterProgress[]

  @@index([unitId])
  @@map("chapters")
}

model Question {
  id        String   @id @default(cuid())
  chapterId String
  question  String
  answer    String
  options   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("questions")
}

model UserCourseProgress {
  id                   String    @id @default(cuid())
  userId               String
  courseId             String
  completedChapters    Int       @default(0)
  totalChapters        Int       @default(0)
  completionPercentage Float     @default(0)
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_course_progress")
}

model UserChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@map("user_chapter_progress")
}

enum PodcastStatus {
  GENERATING
  COMPLETED
  FAILED
}

// Blog posts (admin-created, markdown content)
model BlogPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  content            String // Markdown
  coverImageUrl      String?
  instructorName     String
  instructorImageUrl String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  @@index([slug])
  @@index([publishedAt])
  @@map("blog_posts")
}

// User Onboarding Model
model UserOnboarding {
  id     String @id @default(cuid())
  userId String @unique

  // Onboarding responses
  source         String? // How they found Flinote (instagram, tiktok, facebook, etc.)
  userType       String? // Who will use it (just-me, me-family, someone-else)
  role           String? // Role/occupation (professional, student, parent, teacher, administrator)
  features       Json? // Array of selected features (record, notes, transcripts, ai-chat, quiz, flashcards)
  studyIntensity String? // Study time commitment (light, regular, focused, intense)

  // Marketing: opt-in for tips and product updates (synced to Loops)
  wantsProductUpdates Boolean @default(true)

  // Completion tracking
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  currentStep Int       @default(1) // Track which step they're on

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
  @@map("user_onboarding")
}
