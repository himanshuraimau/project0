generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String      @id // Clerk user ID
  email         String?
  creditBalance Int         @default(10) // Free credits
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  purchases     Purchase[]
  
  @@map("users")
}

model Purchase {
  id            String   @id @default(cuid())
  userId        String
  plan          String   // "free", "basic", "pro"
  credits       Int      // Credits purchased
  amountPaid    Int      // Amount in cents
  dodoPaymentId String?  @unique
  status        String   @default("pending") // "pending", "completed", "failed"
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("purchases")
}

model CreditUsage {
  id         String   @id @default(cuid())
  userId     String
  action     String   // "upload", "notes", "quiz", "flashcard"
  credits    Int      @default(1)
  resourceId String?  // noteId, transcriptId, etc.
  createdAt  DateTime @default(now())
  
  @@map("credit_usage")
}


model Transcript {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  content      String
  cleanContent String
  pages        Int?
  metadata     Json?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  type         String   @default("pdf")
  notes        Note[]

  @@map("transcripts")
}

model Note {
  id           String      @id @default(cuid())
  title        String
  content      String
  transcriptId String
  userId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  flashcard    Flashcard?
  transcript   Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  quiz         Quiz?
  chunks       NoteChunk[] @relation("NoteToChunks")

  @@map("notes")
}

model Flashcard {
  id        String   @id @default(cuid())
  noteId    String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Json
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String   @unique
  content   Json
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model NoteChunk {
  id          Int      @id @default(autoincrement())
  note_id     String
  chunk_text  String   @db.Text
  embedding   Unsupported("vector(768)")
  
  note        Note     @relation("NoteToChunks", fields: [note_id], references: [id], onDelete: Cascade)

  @@index([note_id])
  @@map("note_chunks")
}



model Course {
  id        String   @id @default(cuid())
  name      String
  image     String
  userId    String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]

  @@map("courses")
}

model Unit {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("units")
}

model Chapter {
  id                 String     @id @default(cuid())
  unitId             String
  name               String
  youtubeSearchQuery String
  videoId            String?
  summary            String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  unit               Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions          Question[]

  @@index([unitId])
  @@map("chapters")
}

model Question {
  id        String   @id @default(cuid())
  chapterId String
  question  String   @db.Text
  answer    String   @db.Text
  options   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("questions")
}
