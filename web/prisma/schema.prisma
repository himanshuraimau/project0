generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String      @id // Clerk user ID
  email         String?
  creditBalance Int         @default(10) // Free credits
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  purchases     Purchase[]
  
  @@map("users")
}

model Purchase {
  id            String   @id @default(cuid())
  userId        String
  plan          String   // "free", "basic", "pro"
  credits       Int      // Credits purchased
  amountPaid    Int      // Amount in cents
  dodoPaymentId String?  @unique
  status        String   @default("pending") // "pending", "completed", "failed"
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("purchases")
}

model CreditUsage {
  id         String   @id @default(cuid())
  userId     String
  action     String   // "upload", "notes", "quiz", "flashcard"
  credits    Int      @default(1)
  resourceId String?  // noteId, transcriptId, etc.
  createdAt  DateTime @default(now())
  
  @@map("credit_usage")
}


model Transcript {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  content      String
  cleanContent String
  pages        Int?
  metadata     Json?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  type         String   @default("pdf")
  notes        Note[]

  @@map("transcripts")
}

model Note {
  id           String      @id @default(cuid())
  title        String
  content      String
  transcriptId String
  userId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  flashcard    Flashcard?
  transcript   Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  quiz         Quiz?
  chunks       NoteChunk[] @relation("NoteToChunks")

  @@map("notes")
}

model Flashcard {
  id        String   @id @default(cuid())
  noteId    String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Json
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String   @unique
  content   Json
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model NoteChunk {
  id          Int      @id @default(autoincrement())
  note_id     String
  chunk_text  String   @db.Text
  embedding   Unsupported("vector(768)")
  
  note        Note     @relation("NoteToChunks", fields: [note_id], references: [id], onDelete: Cascade)

  @@index([note_id])
  @@map("note_chunks")
}

model ChapterChunk {
  id          Int      @id @default(autoincrement())
  chapter_id  String
  chunk_text  String   @db.Text
  embedding   Unsupported("vector(768)")
  source      String   @default("notes") // "notes" or "transcript"
  
  chapter     Chapter  @relation("ChapterToChunks", fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_chunks")
}



model Course {
  id        String              @id @default(cuid())
  name      String
  image     String
  userId    String? 
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  units     Unit[]
  userProgress UserCourseProgress[]

  @@map("courses")
}

model Unit {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("units")
}

model Chapter {
  id                 String                @id @default(cuid())
  unitId             String
  name               String
  youtubeSearchQuery String
  videoId            String?
  notes              String?               @db.Text
  transcript         String?               @db.Text
  flashcards         Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  unit               Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions          Question[]
  userProgress       UserChapterProgress[]
  chunks             ChapterChunk[]        @relation("ChapterToChunks")

  @@index([unitId])
  @@map("chapters")
}

model Question {
  id        String   @id @default(cuid())
  chapterId String
  question  String   @db.Text
  answer    String   @db.Text
  options   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("questions")
}

model UserCourseProgress {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  completedChapters Int     @default(0)
  totalChapters    Int     @default(0)
  completionPercentage Float @default(0)
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_course_progress")
}

model UserChapterProgress {
  id          String   @id @default(cuid())
  userId      String
  chapterId   String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@map("user_chapter_progress")
}
