# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# ================================
# AUTHENTICATION (CLERK)
# ================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ================================
# AI SERVICES
# ================================
# OpenAI - Required for embeddings and chat
OPENAI_API_KEY="sk-your_openai_api_key_here"

# Google AI (Optional - for backup or additional features)
GOOGLE_GENERATIVE_AI_API_KEY="your_google_ai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# AI Model Configuration (OpenAI Models)
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_DIM=1536



# ================================
# FILE STORAGE (UPLOADTHING)
# ================================
# UploadThing - Required for audio file storage
# https://uploadthing.com
UPLOADTHING_TOKEN="your_uploadthing_token_here"


# ================================
# EXTERNAL APIS
# ================================
# Unsplash - For course thumbnails
UNSPLASH_API_KEY="your_unsplash_api_key_here"

# YouTube - For video processing
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Web Scraping Services
# https://app.scrapecreators.com/
SCRAPPER_API_KEY="your_scrapper_api_key_here"
SCRAPE_DO_API_TOKEN="your_scrape_do_token_here"

# ================================
# PAYMENT PROCESSING (DODO PAYMENTS)
# ================================
DODO_PAYMENTS_API_KEY="your_dodo_payments_api_key_here"
DODO_PAYMENTS_WEBHOOK_KEY="your_dodo_payments_webhook_key_here"
DODO_PAYMENTS_RETURN_URL="https://your-domain.com/dashboard?payment=success"
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Product IDs for different subscription tiers
NEXT_PUBLIC_DODO_PAYMENT_SUBSCRIPTION_ID=
NEXT_PUBLIC_DODO_PRODUCT_ID_PRO="pdt_your_pro_product_id_here"
NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE="pdt_your_enterprise_product_id_here"



# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ===============================
# ELEVENLABS
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_BASE_URL="https://api.elevenlabs.io/v1"
ELEVEN_LABS_WEBHOOK_SERCRET="your_elevenlabs_webhook_secret_here"
WEBSITE_URL="https://your-domain.com/api/podcast/callback"