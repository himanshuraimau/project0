# =============================================================================
# Copy to `.env` (local) or set in Vercel / CI. Never commit real secrets.
#
# • NEXT_PUBLIC_* — embedded in the browser bundle; only non-secrets.
# • Server-only keys — never prefixed with NEXT_PUBLIC_.
# • Payments reference: ../docs/PAYMENTS_WEB_VS_MOBILE.md
#
# Proxy: this app does not read HTTP_PROXY/HTTPS_PROXY in code; configure your
# host (Vercel, Docker, etc.) if outbound traffic must use a corporate proxy.
# Large uploads: body limits are set in next.config.ts (serverActions /
# proxyClientMaxBodySize), not via env.
# =============================================================================

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# --- Authentication (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars
# Public origin of this Next app (same as NEXT_PUBLIC_APP_URL in most setups)
BETTER_AUTH_URL=http://localhost:3000


GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth (Optional - for social sign-in)
# Get credentials from: https://developer.apple.com/account/resources/authkeys/list
# Service ID (e.g., com.yourcompany.yourapp.si) - this is your clientId
APPLE_CLIENT_ID=your_apple_service_id_here
# Generate JWT using .p8 key, Key ID, and Team ID (max 6 months expiration)
APPLE_CLIENT_SECRET=your_apple_client_secret_jwt_here
# App Bundle Identifier (e.g., com.yourcompany.yourapp.ai) - for native iOS ID token validation
APPLE_APP_BUNDLE_IDENTIFIER=your_apple_app_bundle_id_here

# --- AI (OpenAI + course embeddings) ---
OPENAI_API_KEY=sk-your_openai_key
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# Note generation output cap (kept below model completion-token limit)
NOTE_MAX_OUTPUT_TOKENS=12000
# Optional explicit model completion cap (gpt-5-mini supports up to 128000 output tokens)
NOTE_MODEL_MAX_OUTPUT_TOKENS=128000
# Optional: if set, note generation will use OpenRouter instead of OpenAI
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# Optional tuning (defaults: 1000 / 200) — see embedding-service / chapter-embedding-service
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Paddle Billing (web checkout + webhooks) ---
PADDLE_API_KEY=your_paddle_server_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_signing_secret
PADDLE_RETURN_URL=http://localhost:3000/dashboard?payment=success
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_monthly_id
NEXT_PUBLIC_PADDLE_YEARLY_PRICE_ID=pri_yearly_id

# --- RevenueCat (server: subscriber sync + inbound webhook) ---
# Secret API key from RevenueCat dashboard (Project settings → API keys)
REVENUECAT_SECRET_API_KEY=your_revenuecat_secret_api_key
# Shared secret RevenueCat sends (Authorization or x-revenuecat-auth) → /api/webhook/revenuecat
REVENUECAT_WEBHOOK_AUTH=your_long_random_webhook_secret
REVENUECAT_ENTITLEMENT_ID=pro
# Optional override (default https://api.revenuecat.com/v1)
# REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1

# --- File uploads ---
# UploadThing (server) — /api/uploadthing, lib/uploadthing
UPLOADTHING_TOKEN=your_uploadthing_token

# AWS S3 — large audio/PDF presign flow (lib/s3-audio.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Optional key prefixes (defaults temp/audio, temp/pdf)
# S3_AUDIO_PREFIX=temp/audio
# S3_PDF_PREFIX=temp/pdf

# --- Real-time (Pusher) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# --- Support / marketing ---
# Server: /api/support/contact | Client: support form (NEXT_PUBLIC_*)
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Loops.so (optional — lib/loops.ts)
LOOPS_API_KEY=

# --- External APIs ---
UNSPLASH_API_KEY=
# YouTube metadata via ScrapeCreators (course/youtube.ts)
SCRAPPER_API_KEY=
# Web fetch fallback (webpage-crawler-service.ts)
SCRAPE_DO_API_TOKEN=

# --- Audio TTS ---
UNREAL_SPEECH_API_KEY=
