# APPLICATION CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ================================
# AI SERVICES
# ================================
# OpenAI - Required for embeddings and chat
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# Google Gemini AI - Required for note generation and AI features
# Get API key from: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here


DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# ================================
# PAYMENT PROCESSING (DODO PAYMENTS)
# ================================
# Get credentials from: https://dodopayments.com
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_secret_here
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/dashboard?payment=success
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Subscription Product IDs
NEXT_PUBLIC_DODO_PAYMENT_SUBSCRIPTION_ID=pdt_your_monthly_subscription_id_here
NEXT_PUBLIC_DODO_PRODUCT_ID_PRO_SUBSCRIPTION_YEARLY=pdt_your_yearly_subscription_id_here

# ================================
# EXTERNAL APIS
# ================================
# Unsplash - For course thumbnails
# Get API key from: https://unsplash.com/developers
UNSPLASH_API_KEY=your_unsplash_api_key_here


# Web Scraping Services
# ScrapperAPI - Get from: https://app.scrapecreators.com/
SCRAPPER_API_KEY=your_scrapper_api_key_here

# Scrape.do - Get from: https://dashboard.scrape.do/overview
SCRAPE_DO_API_TOKEN=your_scrape_do_token_here


# ================================
# PDF PROCESSING 
# ================================
# PDF.co - Required for PDF text extraction
# Get API key from: https://pdf.co
PDFCO_API_KEY=your_pdfco_api_key_here

# ================================
# PODCAST MICROSERVICE
# ================================
# Podcast Microservice - Required for podcast generation
# Point to your deployed microservice or local instance
PODCAST_API_URL=http://localhost:3005/api/podcast
PODCAST_API_KEY=your_podcast_api_key_here
WEBHOOK_SECRET=your_webhook_secret_key_here


# ================================
# AUDIO UPLOAD (AWS S3)
# ================================
# Required for upload-audio flow (files > 5MB). Create bucket in AWS S3 and IAM user with s3:PutObject, s3:GetObject.
# Configure bucket CORS to allow PUT from your app origin (e.g. https://yourdomain.com, http://localhost:3000).
# To auto-delete audio files after a set time, add an S3 Lifecycle rule (see docs/s3-audio-lifecycle.md).
# Optional: S3_AUDIO_PREFIX (default: audio-uploads) - key prefix for uploaded audio files
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# ================================
# AUTHENTICATION (BETTER AUTH)
# ================================
# Better Auth - Required for authentication
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional - for social sign-in)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
