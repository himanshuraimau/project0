# APPLICATION CONFIGURATI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ================================
# AI SERVICES (VERCEL AI GATEWAY)
# ================================
# Text generation, structured output, streaming and embeddings route through the
# Vercel AI Gateway using this single key.
# Create a key at: https://vercel.com/dashboard  ->  AI Gateway  ->  API Keys
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Audio (Whisper transcription + podcast TTS) goes DIRECTLY to OpenAI — the gateway
# does not expose /v1/audio/* endpoints. Required for podcast generation and audio notes.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the OpenAI base URL used for audio
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model selection (optional overrides; gateway "creator/model" slug form) ---
# Models without a "creator/" prefix are assumed to be OpenAI (e.g. gpt-4o -> openai/gpt-4o).
# Audio models (AI_MODEL_TRANSCRIPTION / AI_MODEL_TTS) use bare OpenAI names.
EMBEDDING_MODEL=text-embedding-3-small      # -> openai/text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini                       # chatbot / chapter chat / podcast chat
# AI_MODEL_NOTES=google/gemini-2.5-flash-lite        # note generation
# AI_MODEL_SUMMARY=google/gemini-2.5-flash-lite      # source summaries
# AI_MODEL_OCR=google/gemini-2.5-flash               # image OCR
# AI_MODEL_COURSE=gpt-4o                             # course / chapter / mindmap / flashcards
# AI_MODEL_QUIZ=gpt-4o-mini                          # quizzes & note flashcards
# AI_MODEL_TRANSLATION=gpt-4o                        # note translation
# AI_MODEL_TRANSCRIPT=gpt-5-mini                     # podcast / voice transcript script
# AI_MODEL_TRANSCRIPTION=whisper-1                   # audio -> text (Whisper)
# AI_MODEL_TTS=gpt-4o-mini-tts                       # text -> speech (podcast audio)


DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# ================================
# PAYMENT PROCESSING (PADDLE BILLING)
# ================================
# Get credentials from: https://developer.paddle.com
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_RETURN_URL=http://localhost:3000/dashboard?payment=success
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_side_token_here
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Subscription Price IDs
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_your_monthly_price_id_here
NEXT_PUBLIC_PADDLE_YEARLY_PRICE_ID=pri_your_yearly_price_id_here

# Mobile deep-link return URLs (used by /api/subscription/mobile-checkout)
MOBILE_PADDLE_SUCCESS_URL=flinote://payment-status
MOBILE_PADDLE_CANCEL_URL=flinote://payment-status

# ================================
# EMAIL MARKETING (LOOPS)
# ================================
# Loops.so - Contact sync for campaigns (free vs pro, onboarding). Get key: Settings → API
# Optional: omit to skip Loops sync; onboarding and webhooks will still work.
LOOPS_API_KEY=4c3bafe3fd1f9e35c459965f44d96c45

# ================================
# EXTERNAL APIS
# ================================
# Unsplash - For course thumbnails
# Get API key from: https://unsplash.com/developers
UNSPLASH_API_KEY=your_unsplash_api_key_here


# Web Scraping Services
# ScrapperAPI - Get from: https://app.scrapecreators.com/
SCRAPPER_API_KEY=your_scrapper_api_key_here

# Scrape.do - Get from: https://dashboard.scrape.do/overview
SCRAPE_DO_API_TOKEN=your_scrape_do_token_here


# ================================
# PDF PROCESSING 
# ================================
# PDF.co - Required for PDF text extraction
# Get API key from: https://pdf.co
PDFCO_API_KEY=your_pdfco_api_key_here


UNREAL_SPEECH_API_KEY=api_key_for_audio_generation

# ================================
# AUDIO UPLOAD (AWS S3)
# ================================
# Required for upload-audio flow (files > 5MB). Create bucket in AWS S3 and IAM user with s3:PutObject, s3:GetObject.
# Configure bucket CORS to allow PUT from your app origin (e.g. https://yourdomain.com, http://localhost:3000).
# To auto-delete files after a set time, add S3 Lifecycle rules for prefixes temp/audio and temp/pdf.
# Optional: S3_AUDIO_PREFIX (default: temp/audio) - key prefix for uploaded audio; use temp/audio for lifecycle auto-deletion.
# Optional: S3_PDF_PREFIX (default: temp/pdf) - key prefix for uploaded PDFs; use temp/pdf for lifecycle auto-deletion.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# ================================
# AUTHENTICATION (BETTER AUTH)
# ================================
# Better Auth - Required for authentication
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional - for social sign-in)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Apple OAuth (Optional - for social sign-in)
# Get credentials from: https://developer.apple.com/account/resources/authkeys/list
# Follow the Better Auth Apple provider setup guide for detailed steps.
# Service ID (e.g., com.yourcompany.yourapp.si) - this is your clientId
APPLE_CLIENT_ID=your_apple_service_id_here
# Team ID from your Apple Developer account (Membership details)
APPLE_TEAM_ID=your_apple_team_id_here
# Key ID from the .p8 key you generated in Apple Developer Portal
APPLE_KEY_ID=your_apple_key_id_here
# Private key content from the downloaded .p8 file (include -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_private_key_content_here\n-----END PRIVATE KEY-----
# App Bundle Identifier (e.g., com.yourcompany.yourapp) - for native iOS ID token validation
APPLE_APP_BUNDLE_IDENTIFIER=your_apple_app_bundle_id_here

# ================================
# BILLING PROVIDERS (PADDLE + REVENUECAT)
# ================================
# RevenueCat webhook signature (set in RevenueCat dashboard)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here
# RevenueCat environment (sandbox | production)
REVENUECAT_ENVIRONMENT=sandbox
# RevenueCat product IDs (for plan mapping)
REVENUECAT_MONTHLY_PRODUCT_ID=your_rc_monthly_product_id_here
REVENUECAT_YEARLY_PRODUCT_ID=your_rc_yearly_product_id_here
# RevenueCat entitlement ID (default: pro)
REVENUECAT_ENTITLEMENT_ID=pro

# ================================
# REAL-TIME UPDATES (PUSHER)
# ================================
# Pusher Channels - Required for real-time note generation progress on Vercel
# Get credentials from: https://pusher.com (free tier: 100 connections, 200k messages/day)
# Create a Channels app and copy the credentials below

# Server-side credentials (keep these secret)
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_KEY=your_pusher_key_here
PUSHER_SECRET=your_pusher_secret_here
PUSHER_CLUSTER=us2

# Client-side credentials (safe to expose)
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key_here
NEXT_PUBLIC_PUSHER_CLUSTER=us2
