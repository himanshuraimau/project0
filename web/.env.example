# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# ================================
# AUTHENTICATION (CLERK)
# ================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ================================
# AI SERVICES
# ================================
# Google AI (Gemini) - Required for embeddings and chat
GOOGLE_GENERATIVE_AI_API_KEY="your_google_ai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI - Required for advanced AI features
OPENAI_API_KEY="sk-your_openai_api_key_here"

# AI Model Configuration
EMBEDDING_MODEL="models/gemini-embedding-001"
CHAT_MODEL="models/gemini-2.5-flash"
EMBEDDING_DIM=1536

# ================================
# PODCAST GENERATION
# ================================
# ElevenLabs - Required for voice synthesis
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_BASE_URL="https://api.elevenlabs.io/v1"

# Vercel Blob Storage - Required for audio file storage
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"

# ================================
# EXTERNAL APIS
# ================================
# Unsplash - For course thumbnails
UNSPLASH_API_KEY="your_unsplash_api_key_here"

# YouTube - For video processing
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Web Scraping Services
SCRAPPER_API_KEY="your_scrapper_api_key_here"
SCRAPE_DO_API_TOKEN="your_scrape_do_token_here"

# ================================
# PAYMENT PROCESSING (DODO PAYMENTS)
# ================================
DODO_PAYMENTS_API_KEY="your_dodo_payments_api_key_here"
DODO_PAYMENTS_WEBHOOK_KEY="your_dodo_payments_webhook_key_here"
DODO_PAYMENTS_RETURN_URL="https://your-domain.com/dashboard?payment=success"
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Product IDs for different subscription tiers
NEXT_PUBLIC_DODO_PRODUCT_ID_PRO="pdt_your_pro_product_id_here"
NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE="pdt_your_enterprise_product_id_here"

# ================================
# FEATURE FLAGS (OPTIONAL)
# ================================
ENABLE_PODCAST_GENERATION=true
ENABLE_COURSE_GENERATION=true
ENABLE_ANALYTICS=true

# ================================
# RATE LIMITING & QUOTAS (OPTIONAL)
# ================================
MAX_PODCAST_GENERATIONS_PER_DAY=10
MAX_AUDIO_FILE_SIZE_MB=50
MAX_TRANSCRIPT_LENGTH=50000

# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ================================
# SETUP INSTRUCTIONS
# ================================
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual API keys and configuration
# 3. Ensure all required services are set up:
#    - Database (PostgreSQL recommended)
#    - Clerk account for authentication
#    - OpenAI API key for AI features
#    - ElevenLabs API key for podcast generation
#    - Vercel Blob storage for file uploads
# 4. Restart your development server after making changes
#
# For detailed setup instructions, see README.md