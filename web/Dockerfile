# Stage 1: Dependencies
FROM oven/bun:1-alpine AS deps
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy package files and prisma schema (needed for postinstall)
COPY package.json bun.lockb* ./
COPY prisma ./prisma/

# Install dependencies (postinstall will run prisma generate)
RUN bun install --frozen-lockfile

# Stage 2: Builder
FROM oven/bun:1-alpine AS builder
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application code
COPY . .

# Copy prisma schema
COPY prisma ./prisma/

# Generate Prisma Client
RUN bun prisma generate

# Build arguments for ALL environment variables needed during build
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL
ARG NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_DODO_PAYMENT_SUBSCRIPTION_ID
ARG NEXT_PUBLIC_DODO_PRODUCT_ID_PRO
ARG NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE
ARG NEXT_PUBLIC_DODO_PRODUCT_ID_PRO_SUBSCRIPTION
ARG NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE_SUBSCRIPTION
ARG DATABASE_URL
ARG OPENAI_API_KEY
ARG EMBEDDING_MODEL
ARG EMBEDDING_DIM
ARG CHAT_MODEL
ARG GOOGLE_GENERATIVE_AI_API_KEY
ARG GEMINI_API_KEY
ARG DODO_PAYMENTS_API_KEY
ARG DODO_PAYMENTS_WEBHOOK_KEY
ARG DODO_PAYMENTS_RETURN_URL
ARG DODO_PAYMENTS_ENVIRONMENT
ARG CLERK_SECRET_KEY
ARG CLERK_WEBHOOK_SECRET
ARG UPLOADTHING_TOKEN
ARG UNSPLASH_API_KEY
ARG YOUTUBE_API_KEY
ARG SCRAPPER_API_KEY
ARG SCRAPE_DO_API_TOKEN
ARG PDFCO_API_KEY
ARG ELEVEN_LABS_WEBHOOK_SERCRET
ARG ELEVENLABS_API_KEY
ARG ELEVENLABS_BASE_URL
ARG WEBSITE_URL

# Set environment variables for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_URL
ENV NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_DODO_PAYMENT_SUBSCRIPTION_ID=$NEXT_PUBLIC_DODO_PAYMENT_SUBSCRIPTION_ID
ENV NEXT_PUBLIC_DODO_PRODUCT_ID_PRO=$NEXT_PUBLIC_DODO_PRODUCT_ID_PRO
ENV NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE=$NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE
ENV NEXT_PUBLIC_DODO_PRODUCT_ID_PRO_SUBSCRIPTION=$NEXT_PUBLIC_DODO_PRODUCT_ID_PRO_SUBSCRIPTION
ENV NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE_SUBSCRIPTION=$NEXT_PUBLIC_DODO_PRODUCT_ID_ENTERPRISE_SUBSCRIPTION
ENV DATABASE_URL=$DATABASE_URL
ENV OPENAI_API_KEY=$OPENAI_API_KEY
ENV EMBEDDING_MODEL=$EMBEDDING_MODEL
ENV EMBEDDING_DIM=$EMBEDDING_DIM
ENV CHAT_MODEL=$CHAT_MODEL
ENV GOOGLE_GENERATIVE_AI_API_KEY=$GOOGLE_GENERATIVE_AI_API_KEY
ENV GEMINI_API_KEY=$GEMINI_API_KEY
ENV DODO_PAYMENTS_API_KEY=$DODO_PAYMENTS_API_KEY
ENV DODO_PAYMENTS_WEBHOOK_KEY=$DODO_PAYMENTS_WEBHOOK_KEY
ENV DODO_PAYMENTS_RETURN_URL=$DODO_PAYMENTS_RETURN_URL
ENV DODO_PAYMENTS_ENVIRONMENT=$DODO_PAYMENTS_ENVIRONMENT
ENV CLERK_SECRET_KEY=$CLERK_SECRET_KEY
ENV CLERK_WEBHOOK_SECRET=$CLERK_WEBHOOK_SECRET
ENV UPLOADTHING_TOKEN=$UPLOADTHING_TOKEN
ENV UNSPLASH_API_KEY=$UNSPLASH_API_KEY
ENV YOUTUBE_API_KEY=$YOUTUBE_API_KEY
ENV SCRAPPER_API_KEY=$SCRAPPER_API_KEY
ENV SCRAPE_DO_API_TOKEN=$SCRAPE_DO_API_TOKEN
ENV PDFCO_API_KEY=$PDFCO_API_KEY
ENV ELEVEN_LABS_WEBHOOK_SERCRET=$ELEVEN_LABS_WEBHOOK_SERCRET
ENV ELEVENLABS_API_KEY=$ELEVENLABS_API_KEY
ENV ELEVENLABS_BASE_URL=$ELEVENLABS_BASE_URL
ENV WEBSITE_URL=$WEBSITE_URL

# Build the application
RUN bun run build

# Stage 3: Runner
FROM oven/bun:1-alpine AS runner
RUN apk add --no-cache openssl

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Set correct permissions
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Start the application
CMD ["node", "server.js"]
