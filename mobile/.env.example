EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Must match `scheme` in app.config.ts
EXPO_PUBLIC_APP_SCHEME=flinote

# RevenueCat
EXPO_PUBLIC_RC_STORE_MODE=test
EXPO_PUBLIC_RC_TEST_API_KEY=rc_test_sdk_key_here
EXPO_PUBLIC_RC_IOS_API_KEY=appl_ios_sdk_key_here
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_android_sdk_key_here
EXPO_PUBLIC_RC_ENTITLEMENT_ID=pro
EXPO_PUBLIC_RC_DEFAULT_OFFERING_ID=default

# Paddle price IDs used for plan display logic in mobile
EXPO_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_your_monthly_price_id
EXPO_PUBLIC_PADDLE_YEARLY_PRICE_ID=pri_your_yearly_price_id
