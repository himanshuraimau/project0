# =============================================================================
# Expo inlines EXPO_PUBLIC_* at bundle/build time. After changes, restart Metro
# or rebuild (EAS). Copy to `.env` — do not commit secrets.
#
# API: use LAN IP for local backend, e.g. http://192.168.1.5:3000/api (not
# localhost on a physical device). See mobile/SETUP.md.
#
# Payments + RC: ../docs/PAYMENTS_WEB_VS_MOBILE.md
# =============================================================================

# Backend (must include /api prefix)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Deep links / OAuth — must match scheme in app.config.ts
EXPO_PUBLIC_APP_SCHEME=flinote

# --- Apple OAuth (Optional - for social sign-in) ---
# Apple credentials are configured on the backend (web/.env).
# The mobile app uses Better Auth's OAuth web flow — no Apple env vars required here.
# The backend auto-generates the client secret JWT from the .p8 key.
# For native iOS Sign In with Apple using idToken, set:
# EXPO_PUBLIC_APPLE_APP_BUNDLE_IDENTIFIER=ai.flinote.app

# --- RevenueCat ---
# test = Test Store key only | live = platform public SDK keys (iOS/Android)
EXPO_PUBLIC_RC_STORE_MODE=test
EXPO_PUBLIC_RC_TEST_API_KEY=test_xxx_from_revenuecat_dashboard
EXPO_PUBLIC_RC_IOS_API_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_xxx
EXPO_PUBLIC_RC_ENTITLEMENT_ID=pro
EXPO_PUBLIC_RC_DEFAULT_OFFERING_ID=default

# =============================================================================
# EAS / production: set the same variables in Expo dashboard (Environment
# variables) or `eas secret` — .env is not uploaded by default.
# Profiles in eas.json set EXPO_PUBLIC_RC_STORE_MODE for preview vs production.
# =============================================================================
